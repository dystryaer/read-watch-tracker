# The tracker's database: embedded Postgres in a local folder, nothing to install (~ = your home folder).
# The web app, `pnpm import:excel` and `pnpm db:*` all read this file, so they share one database.
DATABASE_URL=pglite:~/.read-watch-tracker/db
# One backup per day while the tracker runs; the newest 14 stay. Restore: pnpm db:restore "<file>"
BACKUP_DIR=~/.read-watch-tracker/backups
# Own server later (docs/server-umzug.md):
# DATABASE_URL=postgres://user:password@host/db

# Login (Better Auth). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# One-time account setup. Optional with `pnpm dev`; with `pnpm start` /setup stays closed without it.
# SETUP_TOKEN=
