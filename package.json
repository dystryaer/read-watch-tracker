{
  "name": "read-watch-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @rwt/web dev",
    "build": "pnpm --filter @rwt/web build",
    "start": "pnpm --filter @rwt/web start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @rwt/db generate",
    "db:migrate": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli-migrate.ts",
    "db:backup": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli-backup.ts backup",
    "db:restore": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli-backup.ts restore",
    "import:excel": "tsx --env-file-if-exists=apps/web/.env.local scripts/import-excel.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rwt/db": "workspace:*",
    "@rwt/server": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
