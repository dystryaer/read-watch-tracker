{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "read",
        "watched",
        "library_sync",
        "backfill"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]{0,99}$"
        },
        "externalKey": {
          "type": "string",
          "maxLength": 1000
        },
        "rawTitle": {
          "type": "string",
          "maxLength": 1000
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/"
        },
        "seriesUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/"
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/"
        }
      },
      "required": [
        "key",
        "externalKey",
        "rawTitle"
      ]
    },
    "position": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "const": "chapter"
            },
            "chapter": {
              "type": "number",
              "minimum": 0,
              "maximum": 99999.99
            }
          },
          "required": [
            "unit",
            "chapter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "const": "episode"
            },
            "season": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                {
                  "type": "null"
                }
              ]
            },
            "episode": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            }
          },
          "required": [
            "unit",
            "season",
            "episode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "const": "percent"
            },
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "unit",
            "percent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "unit"
          ]
        }
      ]
    },
    "mediaTypeHint": {
      "type": "string",
      "enum": [
        "manga",
        "manhwa",
        "manhua",
        "light_novel",
        "ebook",
        "anime",
        "series",
        "movie"
      ]
    }
  },
  "required": [
    "id",
    "occurredAt",
    "kind",
    "source",
    "position"
  ]
}
